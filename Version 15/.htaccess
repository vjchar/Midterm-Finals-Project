# FILE: .htaccess
# PURPOSE: Apache configuration for the public application root.
# USAGE: Disables directory listings, protects internal folders, and rewrites friendly public URLs to organized page files.
# Maintenance: keep these rules aligned with the application structure.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:includes|storage|database|docs|tests|\.git)(?:/|$) - [F,L,NC]

    # Keep the original public URLs while the implementation files stay
    # organized by responsibility. These are internal rewrites, so visitors
    # still use simple addresses such as vehicles.php and booking.php.
    RewriteRule ^(about|contact|services|faq|terms|privacy)\.php$ pages/company/$1.php [L,QSA,NC]
    RewriteRule ^(vehicles|vehicle-details|compare|favorites)\.php$ pages/fleet/$1.php [L,QSA,NC]
    RewriteRule ^(booking|booking-confirmation|booking-view|manage-booking|rate-trip|invoice|rental-adjustment|booking-modification|booking-cancellation)\.php$ pages/booking/$1.php [L,QSA,NC]
    RewriteRule ^(account|profile|my-bookings|documents|payments|notifications|saved-bookings)\.php$ pages/account/$1.php [L,QSA,NC]
    RewriteRule ^(login|register|forgot-password|reset-password|logout|admin-login)\.php$ pages/auth/$1.php [L,QSA,NC]
    RewriteRule ^(admin(?:-[a-z0-9-]+)?|health)\.php$ pages/admin/$1.php [L,QSA,NC]
    RewriteRule ^vehicle-management\.php$ pages/admin/admin-vehicles.php [L,QSA,NC]
    RewriteRule ^booking-management\.php$ pages/admin/admin-bookings.php [L,QSA,NC]
    RewriteRule ^payment-management\.php$ pages/admin/admin-payments.php [L,QSA,NC]
    RewriteRule ^review-management\.php$ pages/admin/admin-reviews.php [L,QSA,NC]
    RewriteRule ^availability\.php$ actions/api.php?action=availability [L,QSA,NC]
    RewriteRule ^booking-estimate\.php$ actions/api.php?action=booking-estimate [L,QSA,NC]
    RewriteRule ^favorite-action\.php$ actions/api.php?action=favorite [L,QSA,NC]
    RewriteRule ^fleet-availability\.php$ actions/api.php?action=fleet-availability [L,QSA,NC]
    RewriteRule ^promo-check\.php$ actions/api.php?action=promo-check [L,QSA,NC]
    RewriteRule ^(review-photo|secure-file)\.php$ actions/$1.php [L,QSA,NC]
    RewriteRule ^403\.php$ errors/error.php?code=403 [L,QSA,NC]
    RewriteRule ^404\.php$ errors/error.php?code=404 [L,QSA,NC]
    RewriteRule ^500\.php$ errors/error.php?code=500 [L,QSA,NC]
    RewriteRule ^setup\.php$ pages/system/setup.php [L,QSA,NC]
</IfModule>

<FilesMatch "(?i)^(?:\.|README(?:$|[._-])|tailwind\.config\.js$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
